@model HomeViewModel
@{
    ViewData["Title"] = "DC Web Systems | Websites & Custom Software";
}

<section class="hero" id="top">
    <div class="hero-copy">
        <p class="eyebrow"><span></span> Web design &amp; software development · Boise, Idaho</p>
        <h1>Web development <em>done right.</em></h1>
        <p class="hero-intro">
            DC Web Systems designs and builds professional websites and custom web applications for businesses and organizations — from polished informational sites to portals, integrations, and purpose-built software.
        </p>
        <div class="hero-actions">
            <a class="button button-primary" href="mailto:dylan@dcwebsystems.com">
                Discuss your project <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link hero-services-link" href="#services">
                Explore services <span aria-hidden="true">↓</span>
            </a>
        </div>
    </div>

    <div class="system-card" aria-label="What DC Web Systems delivers">
        <div class="card-topline">
            <span>DCWS / CAPABILITIES</span>
            <span class="status"><i></i> AVAILABLE</span>
        </div>
        <div class="system-visual" aria-hidden="true">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="core">DC</div>
            <span class="node node-one"></span>
            <span class="node node-two"></span>
            <span class="node node-three"></span>
        </div>
        <div class="card-bottomline">
            <span>WEBSITES</span><span>WEB APPS</span><span>INTEGRATIONS</span>
        </div>
    </div>
</section>

<section class="services" id="services">
    <div class="section-heading">
        <p class="eyebrow"><span></span> What I build</p>
        <h2>From your first page<br />to your custom platform.</h2>
    </div>
    <div class="service-list">
        <article class="service">
            <span class="service-number">01</span>
            <div>
                <h3>Business &amp; organization websites</h3>
                <p>Professional, responsive websites designed around your brand, message, and goals — from informational sites and landing pages to larger content-driven websites. WordPress options make ongoing content updates easy.</p>
            </div>
            <span class="service-arrow" aria-hidden="true">↗</span>
        </article>
        <article class="service">
            <span class="service-number">02</span>
            <div>
                <h3>Custom web applications</h3>
                <p>Purpose-built software that replaces manual work and fits the way your business actually operates, including customer portals, internal dashboards, and tools for your team.</p>
            </div>
            <span class="service-arrow" aria-hidden="true">↗</span>
        </article>
        <article class="service">
            <span class="service-number">03</span>
            <div>
                <h3>APIs &amp; integrations</h3>
                <p>Reliable connections between your website, applications, data, vendors, and third-party services.</p>
            </div>
            <span class="service-arrow" aria-hidden="true">↗</span>
        </article>
        <article class="service">
            <span class="service-number">04</span>
            <div>
                <h3>Website modernization &amp; support</h3>
                <p>Redesigns, feature additions, performance improvements, maintenance, and ongoing development for existing websites.</p>
            </div>
            <span class="service-arrow" aria-hidden="true">↗</span>
        </article>
    </div>
</section>

<section class="work" id="work">
    <div class="section-kicker">
        <p class="eyebrow"><span></span> Selected experience</p>
        <a class="button button-primary" href="/Portfolio">
            View portfolio <span aria-hidden="true">↗</span>
        </a>
    </div>
    <div class="work-grid">
        <article class="work-feature">
            <div class="work-meta"><span>01 / INTERACTIVE TOOL</span><span>.NET • GIS</span></div>
            <div class="map-visual" aria-hidden="true">
                <span class="map-line line-a"></span><span class="map-line line-b"></span>
                <span class="map-line line-c"></span><i class="map-pin pin-a"></i>
                <i class="map-pin pin-b"></i><i class="map-pin pin-c"></i>
            </div>
            <h3>Address &amp; District Lookup</h3>
            <p>Built an interactive address lookup tool that identifies a U.S. address's county, congressional district, state house district, and state senate district and displays the result geographically.</p>
            <a class="text-link work-link" href="/address-lookup">Try the lookup <span aria-hidden="true">↗</span></a>
        </article>
        <article class="work-item work-contribution">
            <div class="work-meta"><span>02 / PROFESSIONAL CONTRIBUTION</span><span>.NET • ARCGIS • APIs</span></div>
            <div class="contribution-marker" aria-hidden="true">02</div>
            <div class="work-item-copy">
                <h3>Utility Outage Map</h3>
                <p>Contributed to the development and modernization of a public-facing utility outage map integrating GIS and outage-management data.</p>
                <p class="project-disclosure">Professional contribution to an Idaho Power product. DC Web Systems is not affiliated with or endorsed by Idaho Power.</p>
                <a class="text-link work-link" href="https://tools.idahopower.com/outage" target="_blank" rel="noopener noreferrer" aria-label="View the Idaho Power outage map (opens in a new tab)">View outage map <span aria-hidden="true">↗</span></a>
            </div>
        </article>
    </div>
</section>

<section class="about" id="about">
    <img class="about-headshot"
         src="/images/dylan-carlson-headshot.webp"
         alt="Dylan Carlson, founder and software developer at DC Web Systems"
         width="800"
         height="1000"
         loading="lazy" />
    <div class="about-content">
        <p class="eyebrow"><span></span> About DC Web Systems</p>
        <h2>Enterprise experience.<br /><em>Personal partnership.</em></h2>
        <div class="about-copy">
            <p>
                I’m Dylan Carlson, a full-stack software developer with experience building customer-facing applications and enterprise systems across account management, billing, mapping, APIs, and operational tools. I combine that technical foundation with a focus on clear design and polished web experiences.
            </p>

            <p>
                Through DC Web Systems, I bring that enterprise engineering experience to businesses and organizations of all sizes — whether you need a polished public-facing website, an integration with an existing service, or a completely custom application. You work directly with me from the first conversation through launch and ongoing support.
            </p>
            <div class="skills">
                <span>Websites</span><span>WordPress</span><span>C# / .NET</span><span>TypeScript</span>
                <span>SQL</span><span>APIs</span><span>Azure</span><span>GIS</span>
            </div>
        </div>
    </div>
</section>

<section class="home-testimonials" aria-labelledby="home-testimonials-heading">
    <div class="section-kicker">
        <div>
            <p class="eyebrow"><span></span> Client experiences</p>
            <h2 id="home-testimonials-heading">What Clients Say</h2>
        </div>
        <a class="button button-primary" asp-controller="Testimonials" asp-action="Index">
            View all testimonials <span aria-hidden="true">↗</span>
        </a>
    </div>
    @if (Model.Testimonials.Count > 0)
    {
        <div class="testimonial-grid">
            @foreach (var testimonial in Model.Testimonials)
            {
                <partial name="_TestimonialCard" model="testimonial" />
            }
        </div>
    }
    else
    {
        <p class="testimonials-empty">Approved client stories will be shared here soon.</p>
    }
</section>

<section class="contact">
    <p class="eyebrow"><span></span> Have a project in mind?</p>
    <h2>Let’s build something<br />that works <em>for you.</em></h2>
    <a class="button button-light" href="mailto:dylan@dcwebsystems.com">
        dylan@dcwebsystems.com <span aria-hidden="true">↗</span>
    </a>
</section>
